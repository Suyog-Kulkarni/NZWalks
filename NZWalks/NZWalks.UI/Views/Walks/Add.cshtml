@model NZWalks.UI.Models.DTO.AddWalkViewModel

@{
    ViewData["Title"] = "Add New Walk";
}

<h1 class="mt-3">Add New Walk</h1>

<form method="post" asp-action="Add" class="mt-3">
    @* Display validation errors *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LengthInKm" class="form-label">Length (Km)</label>
        <input asp-for="LengthInKm" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="LengthInKm" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="WalkImageUrl" class="form-label">Walk Image URL (Optional)</label>
        <input asp-for="WalkImageUrl" class="form-control" />
        <span asp-validation-for="WalkImageUrl" class="text-danger"></span>
    </div>

    @* Note: DifficultyId and RegionId should ideally be dropdowns (select lists).
       You would need to fetch the available Difficulties and Regions in the
       GET Add action in the controller, pass them to the view (e.g., via ViewBag
       or by adding IEnumerable properties to AddWalkViewModel), and then use
       <select asp-for="DifficultyId" asp-items="@ViewBag.DifficultiesList" class="form-select">
         <option value="">-- Select Difficulty --</option>
       </select>
       For now, using simple text inputs for the Guids.
    *@
    <div class="mb-3">
        <label asp-for="DifficultyId" class="form-label">Difficulty ID</label>
        <input asp-for="DifficultyId" class="form-control" /> @* Replace with <select> later *@
        <span asp-validation-for="DifficultyId" class="text-danger"></span>
    </div>

     <div class="mb-3">
        <label asp-for="RegionId" class="form-label">Region ID</label>
        <input asp-for="RegionId" class="form-control" /> @* Replace with <select> later *@
        <span asp-validation-for="RegionId" class="text-danger"></span>
    </div>


    <button type="submit" class="btn btn-primary">
        <i class="bi bi-save"></i> Save Walk
    </button>
    <a asp-action="Index" class="btn btn-secondary ms-2">
        <i class="bi bi-x-circle"></i> Cancel
    </a>
</form>

@* Include client-side validation scripts *@
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 