@model IEnumerable<NZWalks.UI.Models.DTO.RegionsDTO>

<h1 class="mt-3">Region</h1>
<div class="d-flex justify-content-end">
    <a class="btn btn-secondary" asp-controller="Regions" asp-action="Add">Add Region</a>
</div>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Code</th>
            <th>Name</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var region in Model)
        {
            <tr>
                <td>@region.Id</td>
                <td>@region.Code</td>
                <td>@region.Name</td>
                <td>
                    <a class="btn btn-primary" asp-controller="Regions" asp-action="Edit" asp-route-id="@region.Id" class="btn btn-primary mx-2">
                        <i class="bi bi-pencil-square"></i>Edit
                    </a>
                </td>
                <td>
                    <a asp-controller="Regions" asp-action="Delete" asp-route-id="@region.Id"
                       class="btn btn-danger mx-2">
                        <i class="bi bi-trash-fill"></i>Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>